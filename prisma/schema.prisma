generator client {
  provider     = "prisma-client"
  output       = "../prisma/client"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  password  String?
  createdAt DateTime @updatedAt
}

model Article {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  text        String
  publishedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([publishedAt, id])
}
